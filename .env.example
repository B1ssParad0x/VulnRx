# Local TimescaleDB started by docker compose. Not a secret.
DATABASE_URL=postgres://vulnrx:vulnrx@localhost:5432/vulnrx

# Optional. vulnrx-api listens here when BIND_ADDR is unset.
BIND_ADDR=127.0.0.1:8080

# Optional. Register at https://chpl.healthit.gov (CHPL Resources, CHPL API).
# `vulnrx-etl expand-cehrt` uses it to turn 2024 bundle ids into product links.
CHPL_API_KEY=
# Your API key must be included in all API calls via either a header with the name "API-Key" or as a URL parameter named "api_key".

# Optional. Request a key at https://nvd.nist.gov/developers/request-an-api-key.
# Without it, `vulnrx-etl kev` waits between NVD pages.
NVD_API_KEY=

# Optional. SEC asks automated clients to identify themselves.
# `vulnrx-etl edgar` uses this user agent.
SEC_USER_AGENT=

# Optional. Request a key at https://developer.shodan.io/ (Shodan API).
# `vulnrx-etl shodan` uses this API key.
SHODAN_API_KEY=

# Optional. Request a key at https://censys.io/ (Censys API).
# `vulnrx-etl censys` uses this API key.
CENSYS_API_KEY=


# Optional. The API calls Gemini only when someone clicks Explain on a CVE.
# The reply is stored, so that CVE is not sent again. Model is gemini-3.5-flash-lite
# with thinking off and a short output cap.
GEMINI_API_KEY=